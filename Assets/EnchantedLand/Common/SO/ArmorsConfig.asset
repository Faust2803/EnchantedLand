  _armorsList:
  - Id: 0
    Image: {fileID: 0}
    Title: "\u041F\u043E\u043B\u043D\u044B\u0439 \u0434\u043E\u0441\u043F\u0435\u0445"
    Description: "\u041F\u043E\u043B\u043D\u044B\u0439 \u0434\u043E\u0441\u043F\u0435\u0445
      \u2014 \u0442\u044F\u0436\u0451\u043B\u044B\u0439 \u043A\u043E\u043C\u043F\u043B\u0435\u043A\u0442
      \u0437\u0430\u0449\u0438\u0442\u043D\u044B\u0445 \u043F\u043B\u0430\u0441\u0442\u0438\u043D,
      \u0437\u0430\u043A\u0440\u044B\u0432\u0430\u044E\u0449\u0438\u0439 \u0442\u0435\u043B\u043E
      \u0432\u043E\u0438\u043D\u0430 \u0441 \u0433\u043E\u043B\u043E\u0432\u044B
      \u0434\u043E \u043D\u043E\u0433. \u041F\u0440\u043E\u0447\u043D\u044B\u0435
      \u0441\u0442\u0430\u043B\u044C\u043D\u044B\u0435 \u044D\u043B\u0435\u043C\u0435\u043D\u0442\u044B
      \u043D\u0430\u0434\u0451\u0436\u043D\u043E \u0437\u0430\u0449\u0438\u0449\u0430\u044E\u0442
      \u043E\u0442 \u0443\u0434\u0430\u0440\u043E\u0432 \u043C\u0435\u0447\u0435\u0439,
      \u0441\u0442\u0440\u0435\u043B \u0438 \u043A\u043E\u0433\u0442\u0435\u0439,
      \u043D\u043E \u0442\u0440\u0435\u0431\u0443\u044E\u0442 \u0441\u0438\u043B\u044B
      \u0438 \u0432\u044B\u043D\u043E\u0441\u043B\u0438\u0432\u043E\u0441\u0442\u0438
      \u0434\u043B\u044F \u043D\u043E\u0448\u0435\u043D\u0438\u044F. \u0422\u0430\u043A\u043E\u0439
      \u0434\u043E\u0441\u043F\u0435\u0445 \u043F\u0440\u0435\u0432\u0440\u0430\u0449\u0430\u0435\u0442
      \u0441\u0432\u043E\u0435\u0433\u043E \u0432\u043B\u0430\u0434\u0435\u043B\u044C\u0446\u0430
      \u0432 \u043D\u0430\u0441\u0442\u043E\u044F\u0449\u0443\u044E \u043A\u0440\u0435\u043F\u043E\u0441\u0442\u044C,
      \u0441\u043F\u043E\u0441\u043E\u0431\u043D\u0443\u044E \u0432\u044B\u0434\u0435\u0440\u0436\u0430\u0442\u044C
      \u0434\u0430\u0436\u0435 \u0441\u0430\u043C\u044B\u0435 \u0436\u0435\u0441\u0442\u043E\u043A\u0438\u0435
      \u0430\u0442\u0430\u043A\u0438."
    Price: 200
    NeededCharacteristics:
