    Description: "\u041A\u043E\u0436\u0430\u043D\u044B\u0435 \u043F\u0435\u0440\u0447\u0430\u0442\u043A\u0438
      \u2014 \u043B\u0451\u0433\u043A\u0430\u044F \u0437\u0430\u0449\u0438\u0442\u0430
      \u0434\u043B\u044F \u0440\u0443\u043A \u0438\u0437 \u043F\u0440\u043E\u0447\u043D\u043E\u0439
      \u0432\u044B\u0434\u0435\u043B\u0430\u043D\u043D\u043E\u0439 \u043A\u043E\u0436\u0438.
      \u041E\u043D\u0438 \u043E\u0431\u0435\u0440\u0435\u0433\u0430\u044E\u0442 \u043B\u0430\u0434\u043E\u043D\u0438
      \u043E\u0442 \u043C\u043E\u0437\u043E\u043B\u0435\u0439, \u0445\u043E\u043B\u043E\u0434\u0430
      \u0438 \u043C\u0435\u043B\u043A\u0438\u0445 \u043F\u043E\u0440\u0435\u0437\u043E\u0432,
      \u043D\u0435 \u0441\u043A\u043E\u0432\u044B\u0432\u0430\u044F \u0434\u0432\u0438\u0436\u0435\u043D\u0438\u044F
      \u043F\u0430\u043B\u044C\u0446\u0435\u0432. \u041F\u0440\u0430\u043A\u0442\u0438\u0447\u043D\u0430\u044F
      \u044D\u043A\u0438\u043F\u0438\u0440\u043E\u0432\u043A\u0430 \u0434\u043B\u044F
      \u0432\u043E\u0438\u043D\u0430, \u043E\u0445\u043E\u0442\u043D\u0438\u043A\u0430
      \u0438\u043B\u0438 \u043F\u0443\u0442\u0435\u0448\u0435\u0441\u0442\u0432\u0435\u043D\u043D\u0438\u043A\u0430,
      \u043F\u0440\u0438\u0432\u044B\u043A\u0448\u0435\u0433\u043E \u043F\u043E\u043B\u0430\u0433\u0430\u0442\u044C\u0441\u044F
