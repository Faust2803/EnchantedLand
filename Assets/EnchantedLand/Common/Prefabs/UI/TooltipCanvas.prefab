    - target: {fileID: 7968790633113129500, guid: 951171bf8a3cfbe46bcee8b14c171427, type: 3}
      propertyPath: m_text
      value: "\u0421\u043E\u0437\u0434\u0430\u0439 \u0441\u0432\u043E\u0435\u0433\u043E
        \u0433\u0435\u0440\u043E\u044F \u0438 \u043E\u0442\u043F\u0440\u0430\u0432\u044C\u0441\u044F
        \u043D\u0430\u0432\u0441\u0442\u0440\u0435\u0447\u0443 \u043E\u043F\u0430\u0441\u043D\u044B\u043C
        \u043F\u0440\u0438\u043A\u043B\u044E\u0447\u0435\u043D\u0438\u044F\u043C.
        \u0412\u044B\u0431\u0435\u0440\u0438 \u0440\u0430\u0441\u0443,  \u0438 \u0440\u0430\u0441\u043F\u0440\u0435\u0434\u0435\u043B\u0438
        \u0445\u0430\u0440\u0430\u043A\u0442\u0435\u0440\u0438\u0441\u0442\u0438\u043A\u0438,
        \u0447\u0442\u043E\u0431\u044B \u043E\u043F\u0440\u0435\u0434\u0435\u043B\u0438\u0442\u044C
        \u0441\u0438\u043B\u044C\u043D\u044B\u0435 \u0438 \u0441\u043B\u0430\u0431\u044B\u0435
        \u0441\u0442\u043E\u0440\u043E\u043D\u044B \u0441\u0432\u043E\u0435\u0433\u043E
        \u043F\u0435\u0440\u0441\u043E\u043D\u0430\u0436\u0430.\n"
      objectReference: {fileID: 0}
